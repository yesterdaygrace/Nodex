APP_ENV=production
APP_PORT=8080
APP_NAME=Nodex
APP_URL=https://demo.example.com

# Database - 12-factor DATABASE_URL preferred
DATABASE_URL=postgres://postgres:postgres@postgres:5432/test_db?sslmode=disable
# Discrete vars alternative
DB_HOST=postgres
DB_PORT=5432
DB_NAME=test_db
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=change-me-to-32-bytes-random-minimum
JWT_EXPIRATION=24h

# CORS - comma-separated allowed origins, * disallowed for auth APIs
CORS_ALLOWED_ORIGINS=https://demo.example.com

# Redis (optional)
REDIS_URL=redis://redis:6379/0
